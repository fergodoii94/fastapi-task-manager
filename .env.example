APP_ENV=development
APP_NAME=Task Manager API
DATABASE_URL=sqlite:///./task_manager.db
API_V1_PREFIX=/api/v1
# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=development-only-change-this-secret-before-deployment-please
ACCESS_TOKEN_EXPIRE_MINUTES=30
